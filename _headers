# Netlify Cache Control and Security Headers

# Unversioned assets (CSS, images, icons, logos, fonts)
# Use revalidation so updates take effect without stale caching issues while still leveraging browser caches
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# HTML pages and routes must always revalidate immediately to deliver updates fresh
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/en/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/en/
  Cache-Control: public, max-age=0, must-revalidate

/arteminder
  Cache-Control: public, max-age=0, must-revalidate

/en/arteminder
  Cache-Control: public, max-age=0, must-revalidate

/privacy
  Cache-Control: public, max-age=0, must-revalidate

/en/privacy
  Cache-Control: public, max-age=0, must-revalidate

# Global Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
